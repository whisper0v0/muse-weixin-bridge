{
  "name": "muse-weixin-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "durable_objects": {
    "code_update_strategy": {
      "mode": "immediate"
    },
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "WeixinAccount"
      },
      {
        "name": "OAUTH",
        "class_name": "OAuthState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WeixinAccount"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "OAuthState"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
      "APP_ORIGIN": "https://muse-weixin-bridge.wjy1503617042.workers.dev",
    "OAUTH_REDIRECT_URIS": "https://chatgpt.com/connector_platform_oauth_redirect",
    "EVENTS_DISCOVERY_ENABLED": "false",
    "CALLBACK_HOSTS": " "
  }
}
